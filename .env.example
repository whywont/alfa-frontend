# Leave DATABASE_URL unset to use an embedded PGlite database in .data/pglite (local dev).
# Set it to a Neon/Postgres URL in production.
DATABASE_URL=

# Public base URL the worker uses to reach this app (used to build upload URLs).
PUBLIC_URL=http://localhost:3000

# HMAC secret for local-storage upload URLs. Any long random string.
STORAGE_SECRET=change-me

# Production file storage (Cloudflare R2). Leave unset to store files under .data/storage.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Vercel sends this as a bearer token to /api/cron/sweep.
CRON_SECRET=
